# Copy to .env and fill in. Never commit the real .env file.

# Which LLM provider does structured extraction + RAG answer generation.
# "anthropic" (default) or "gemini".
LLM_PROVIDER=gemini

# Set whichever key matches LLM_PROVIDER above.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides.
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ESG_DATA_DIR=./data
